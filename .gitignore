# Local SQLite databases with actual user records (template or blank is acceptable)
data/agency_history.db
data/agency_history.db-wal
data/agency_history.db-shm

# IDE & OS files
.vscode/
.idea/
Thumbs.db
Desktop.ini
.DS_Store

# Output reports
output/
